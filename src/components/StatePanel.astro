---
// The state and territory panel (plan section 3): small charts in a fixed order (NSW, Vic, Qld, WA, SA,
// Tas, ACT, NT), all on the same y-axis scale, no ranking colours, each with a thin grey line for the
// national figure and the same government shading as the main chart. Under the charts, a short table of
// the latest figure for each place in the same fixed order (not sorted by value). Everything shown comes
// from the `panel` prop (built from metric.yml and data.csv in src/lib/metrics.ts). Nothing here belongs
// to any one metric.
import type { PanelData } from '../lib/metrics';

interface Props {
  panel: PanelData;
}
const { panel } = Astro.props;
const json = JSON.stringify(panel).replace(/</g, '\\u003c');
---
<div class="state-panel" data-state-panel>
  <h2>{panel.heading}</h2>
  <p class="panel-note">{panel.note}</p>
  <div class="panel-legend">
    <span><span class="sw sw-national"></span>{panel.nationalLabel}</span>
    <span><span class="sw sw-band"></span>Shading marks a change of governing party</span>
  </div>
  <div class="panel-grid">
    {panel.places.map((p) => (
      <figure class="panel-cell" data-place={p.label}>
        <figcaption>{p.label}</figcaption>
        <div class="panel-wrap">
          <svg viewBox="0 0 300 200" role="img" aria-label={`${p.label}: ${panel.table.headers[panel.table.headers.length - 1]}, ${p.points[0].period} to ${p.points[p.points.length - 1].period}`}></svg>
          <div class="panel-tip"></div>
        </div>
      </figure>
    ))}
  </div>
  <div class="scroll">
    <table class="panel-table">
      <thead>
        <tr>{panel.table.headers.map((h) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {panel.table.rows.map((r) => (
          <tr><td>{r.place}</td><td>{r.month}</td>{r.extras.map((x) => <td>{x}</td>)}<td>{r.value}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <script type="application/json" data-panel-data set:html={json} />
</div>

<style is:global>
  .state-panel .panel-note { color: var(--ink-2); font-size: 14px; }
  .state-panel .panel-legend { display: flex; flex-wrap: wrap; gap: 18px; font-size: 14px; color: var(--ink-2); margin-bottom: 8px; }
  .state-panel .sw { display: inline-block; width: 18px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
  .state-panel .sw-national { background: var(--ink-3); height: 2px; }
  .state-panel .sw-band { background: var(--band); height: 12px; border: 1px solid var(--rule); }
  .state-panel .panel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px 12px; margin: 6px 0 14px; }
  .state-panel .panel-cell { margin: 0; }
  .state-panel figcaption { font-weight: 600; font-size: 14px; margin-bottom: 2px; }
  .state-panel .panel-wrap { position: relative; }
  .state-panel svg { display: block; width: 100%; height: auto; font-family: var(--body); }
  .state-panel .panel-tip { position: absolute; pointer-events: none; background: var(--card); border: 1px solid var(--rule); border-radius: 6px; padding: 5px 8px; font-size: 12px; box-shadow: 0 4px 14px rgba(0, 0, 0, .14); display: none; white-space: nowrap; font-variant-numeric: tabular-nums; top: 20px; }
  .state-panel .panel-tip b { display: block; }
  .state-panel .panel-table { max-width: 34rem; }
</style>

<script>
  import { decimalYear, formatAxis, formatDate, formatMonthYear, formatValue } from '../lib/format';

  const NS = 'http://www.w3.org/2000/svg';
  // Drawing area of one small chart, in the SVG's own units.
  const W = 300, H = 200, L = 36, R = 36, T = 22, B = 22;
  const PAD = 0.12; // years of space before the first and after the last point

  type Pt = { date: string; period: string; value: number };
  type Panel = {
    unit: string; frequency: string; nationalLabel: string; national: Pt[];
    places: { label: string; name: string; abbreviation: string; points: Pt[] }[];
    governments: { date: string; party: string }[];
    events: { date: string; label: string }[];
  };

  function niceStep(range: number): number {
    const raw = range / 4, p = Math.pow(10, Math.floor(Math.log10(raw)));
    for (const m of [1, 2, 2.5, 5, 10]) if (raw <= m * p) return m * p;
    return 10 * p;
  }

  function start(root: HTMLElement) {
    const panel: Panel = JSON.parse(root.querySelector('script[data-panel-data]')!.textContent!);
    const plotW = W - L - R, plotH = H - T - B;

    // One scale for every chart: it has to fit every place and the national line.
    const all = [...panel.national, ...panel.places.flatMap((p) => p.points)];
    const vals = all.map((p) => p.value);
    const lo = Math.min(0, ...vals), hi = Math.max(...vals);
    const step = niceStep(hi - lo);
    const y0 = Math.floor(lo / step) * step, y1 = Math.ceil(hi / step) * step;
    const times = all.map((p) => decimalYear(p.date));
    const xa = Math.min(...times) - PAD, xb = Math.max(...times) + PAD;
    const x = (t: number) => L + (t - xa) / (xb - xa) * plotW;
    const y = (v: number) => T + (y1 - v) / (y1 - y0) * plotH;

    root.querySelectorAll<HTMLElement>('figure[data-place]').forEach((fig, k) => {
      const place = panel.places[k];
      const svg = fig.querySelector('svg')!;
      const tip = fig.querySelector<HTMLElement>('.panel-tip')!;
      const el = (name: string, attrs: Record<string, string | number>, text?: string | number) => {
        const e = document.createElementNS(NS, name);
        for (const key in attrs) e.setAttribute(key, String(attrs[key]));
        if (text != null) e.textContent = String(text);
        svg.appendChild(e);
        return e;
      };

      // Government bands, from shared/governments.csv, drawn the way the main chart draws them.
      const gov = panel.governments.map((g, i) => {
        const a = decimalYear(g.date);
        const b = i + 1 < panel.governments.length ? decimalYear(panel.governments[i + 1].date) : xb;
        return { party: g.party, a: Math.max(a, xa), b: Math.min(b, xb), vis: b > xa && a < xb };
      }).filter((g) => g.vis);
      gov.forEach((g, j) => {
        const wpx = x(g.b) - x(g.a);
        if (j % 2 === 1) el('rect', { x: x(g.a), y: T, width: wpx, height: plotH, fill: 'var(--band)' });
        if (wpx > 44) el('text', { x: x(g.a) + wpx / 2, y: T - 8, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--ink-3)' }, g.party);
        if (j > 0) el('line', { x1: x(g.a), x2: x(g.a), y1: T - 4, y2: T, stroke: 'var(--ink-3)', 'stroke-width': 1 });
      });

      // Gridlines, zero line and y labels (the same on every chart).
      for (let v = y0; v <= y1 + 1e-9; v += step) {
        el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: v === 0 ? 'var(--ink-3)' : 'var(--rule)', 'stroke-width': 1 });
        el('text', { x: L - 5, y: y(v) + 4, 'text-anchor': 'end', 'font-size': 10.5, fill: 'var(--ink-3)' }, formatAxis(panel.unit, +v.toFixed(6)));
      }
      // Year labels: every year if they fit, otherwise every second or fifth year (about 30 px each).
      const pxPerYear = plotW / (xb - xa);
      const yearStep = [1, 2, 5, 10].find((k) => k * pxPerYear >= 34) ?? 10;
      for (let yr = Math.ceil(xa / yearStep) * yearStep; yr <= xb; yr += yearStep) {
        el('text', { x: x(yr), y: H - B + 14, 'text-anchor': 'middle', 'font-size': 10.5, fill: 'var(--ink-3)' }, yr);
      }
      // Event marks from shared/events.csv that fall inside the period (none do for a short series).
      panel.events.filter((e) => { const t = decimalYear(e.date); return t >= xa && t <= xb; }).forEach((e) => {
        el('line', { x1: x(decimalYear(e.date)), x2: x(decimalYear(e.date)), y1: T, y2: H - B, stroke: 'var(--ink-3)', 'stroke-width': 1, 'stroke-dasharray': '3 4' });
      });

      const path = (pts: Pt[]) => pts.map((p, i) => (i ? 'L' : 'M') + x(decimalYear(p.date)).toFixed(1) + ' ' + y(p.value).toFixed(1)).join('');
      el('path', { d: path(panel.national), fill: 'none', stroke: 'var(--ink-3)', 'stroke-width': 1, 'stroke-linejoin': 'round' });
      el('path', { d: path(place.points), fill: 'none', stroke: 'var(--series-1)', 'stroke-width': 2, 'stroke-linejoin': 'round' });
      const last = place.points[place.points.length - 1];
      el('circle', { cx: x(decimalYear(last.date)), cy: y(last.value), r: 3.5, fill: 'var(--series-1)', stroke: 'var(--card)', 'stroke-width': 1.5 });
      el('text', { x: x(decimalYear(last.date)) + 7, y: y(last.value) + 4, 'font-size': 11.5, 'font-weight': 600, fill: 'var(--ink)' }, formatValue(panel.unit, last.value));

      // Hover read-out: the month, this place and the national figure.
      const cross = el('line', { y1: T, y2: H - B, stroke: 'var(--ink-2)', 'stroke-width': 1, visibility: 'hidden' });
      const hit = el('rect', { x: L, y: T, width: plotW, height: plotH, fill: 'transparent' });
      const natByDate = new Map(panel.national.map((p) => [p.date, p]));
      function move(ev: PointerEvent) {
        const b = svg.getBoundingClientRect(), px = (ev.clientX - b.left) / b.width * W;
        const t = xa + (px - L) / plotW * (xb - xa);
        let r = place.points[0];
        for (const q of place.points) if (Math.abs(decimalYear(q.date) - t) < Math.abs(decimalYear(r.date) - t)) r = q;
        const cx = x(decimalYear(r.date));
        cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx)); cross.setAttribute('visibility', 'visible');
        const nat = natByDate.get(r.date);
        tip.replaceChildren();
        const head = document.createElement('b');
        head.textContent = panel.frequency === 'annual' ? formatDate(r.date) : formatMonthYear(r.date);
        tip.appendChild(head);
        tip.appendChild(document.createTextNode(`${place.name}: ${formatValue(panel.unit, r.value)}`));
        tip.appendChild(document.createElement('br'));
        tip.appendChild(document.createTextNode(`${panel.nationalLabel}: ${nat ? formatValue(panel.unit, nat.value) : 'no figure'}`));
        tip.style.display = 'block';
        const left = cx / W * b.width;
        tip.style.left = Math.min(Math.max(left + 8, 0), Math.max(b.width - 150, 0)) + 'px';
      }
      hit.addEventListener('pointermove', move as EventListener);
      hit.addEventListener('pointerdown', move as EventListener);
      hit.addEventListener('pointerleave', () => { tip.style.display = 'none'; cross.setAttribute('visibility', 'hidden'); });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-state-panel]').forEach(start);
</script>
